CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_GPIO=y

CONFIG_LED_RGB_COLOR=y

CONFIG_SLIMEVR_USB_DEVICE_MANUFACTURER="Mocha-Elec"
CONFIG_SLIMEVR_USB_DEVICE_PRODUCT="Mochi Receiver"

CONFIG_USE_SEGGER_RTT=y
CONFIG_RTT_CONSOLE=y
CONFIG_LOG_BACKEND_RTT=y

#generate for adafruit uf2 bootloader flashing
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_BUILD_OUTPUT_UF2_FAMILY_ID="0x621e937a"
CONFIG_FLASH_LOAD_OFFSET=0x1000
# no FEM on the Mochi: bare nRF52833 radio caps out at +8 dBm
CONFIG_RADIO_TX_POWER=8
