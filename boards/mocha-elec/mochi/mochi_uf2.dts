/dts-v1/;
#include <nordic/nrf52833_qiaa.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

&pinctrl {
	pwm0_default: pwm0_default {
		group1 {
			/* channel order must match firmware led_pwm_period: ch0=red, ch1=green, ch2=blue */
			psels = <NRF_PSEL(PWM_OUT0, 0, 20)>,<NRF_PSEL(PWM_OUT1, 0, 9)>,<NRF_PSEL(PWM_OUT2, 0, 17)>;
			nordic,drive-mode = <NRF_DRIVE_D0S1>;
		};
	};

	pwm0_sleep: pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 20)>,<NRF_PSEL(PWM_OUT1, 0, 9)>,<NRF_PSEL(PWM_OUT2, 0, 17)>;
			low-power-enable;
		};
	};
};

/ {
	model = "Mocha-Elec Mochi nRF52833 Receiver";
	compatible = "mochi_uf2";

	chosen {
		zephyr,console = &cdc_acm_uart;
		zephyr,shell-uart = &cdc_acm_uart;
		zephyr,uart-mcumgr = &cdc_acm_uart;
		zephyr,bt-mon-uart = &cdc_acm_uart;
		zephyr,bt-c2h-uart = &cdc_acm_uart;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,ieee802154 = &ieee802154;
	};

	leds {
		compatible = "gpio-leds";
		led0_red: led_0 {
			gpios = <&gpio0 20 GPIO_OPEN_SOURCE>;
			label = "Red LED 0";
		};
		led1_green: led_1 {
			gpios = <&gpio0 9 GPIO_OPEN_SOURCE>;
			label = "Green LED 1";
		};
		led2_blue: led_2 {
			gpios = <&gpio0 17 GPIO_OPEN_SOURCE>;
			label = "Blue LED 2";
		};
	};

	pwmleds {
		compatible = "pwm-leds";
		/* active-high LEDs: use normal polarity so value 0 = off */
		red_pwm_led: pwm_led_0 {
			pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
		};
		green_pwm_led: pwm_led_1 {
			pwms = <&pwm0 1 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
		};
		blue_pwm_led: pwm_led_2 {
			pwms = <&pwm0 2 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
		};
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&gpio0 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Push button switch 0";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	aliases {
		sw0 = &button0;
		led0 = &led0_red;
		led1 = &led1_green;
		led2 = &led2_blue;
		led0-red   = &led0_red;
		led1-green = &led1_green;
		led2-blue  = &led2_blue;
		pwm-led0 = &red_pwm_led;
		pwm-led1 = &green_pwm_led;
		pwm-led2 = &blue_pwm_led;
		red-pwm-led = &red_pwm_led;
		green-pwm-led = &green_pwm_led;
		blue-pwm-led = &blue_pwm_led;
		watchdog0 = &wdt0;
	};
};

&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&adc {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpiote {
	status = "okay";
};

&uicr {
	/* green LED sits on P0.09 (NFC1) */
	nfct-pins-as-gpios;
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&ieee802154 {
	status = "okay";
};

zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";
	cdc_acm_uart: cdc_acm_uart {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&nfct {
	status = "disabled";
};
